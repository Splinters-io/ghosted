# Ghosted V8 - Environment Configuration
# Copy this file to .env and add your API keys

# PublicWWW API Key (optional - for domain research)
# Get your key from: https://publicwww.com/
PUBLICWWW_KEY=your_publicwww_api_key_here

# AWS Credentials (for Route53 domain checking)
# Get from AWS IAM Console
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1
